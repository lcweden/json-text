{
  "tasks": {
    "check": "deno check && deno fmt --check",
    "bench": "deno bench",
    "dev": "deno test --watch",
    "format": "deno fmt",
    "lint": "deno lint && deno doc --lint src",
    "test": "deno test --clean --coverage"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "@std/expect": "jsr:@std/expect",
    "@src/": "./src/",
    "#src/": "./src/"
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false,
    "spaceAround": true,
    "useBraces": "always"
  }
}
